<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 插件代码跑在宿主进程里，用的是宿主的权限集。这里声明插件（如微信）常用的权限。
         normal 级（INTERNET / ACCESS_NETWORK_STATE / ACCESS_WIFI_STATE / WAKE_LOCK / VIBRATE）声明即授予，
         直接解决 Cronet 的 "Neither user nor process has ACCESS_NETWORK_STATE"；
         dangerous 级（存储/相机/麦克风/定位/电话）声明后仍需运行时动态申请。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- 插件包名可能与手机上真实安装的包同名（如 com.tencent.mm）；没有包可见性权限时，宿主查询该包会被
         AppsFilter 挡住并抛 "Unknown package"，连累 Cronet 等 native 初始化崩溃。放开可见性。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application android:name=".MultiOpenApp" android:label="MultiOpen" android:theme="@style/Theme.AppCompat.Light.DarkActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 桩 Activity：每个虚拟进程/实例对应一个，后续扩展为多个 -->
        <activity android:name=".ProxyActivity" android:exported="false" />
        <!-- 桩 Activity 池：多个桩类轮换，避免 SINGLE_TOP 把目标投递到栈顶同一个桩而不新建 -->
        <activity android:name=".StubActivity" android:exported="false" />
        <activity android:name=".StubActivity1" android:exported="false" />
        <activity android:name=".StubActivity2" android:exported="false" />
        <activity android:name=".StubActivity3" android:exported="false" />
        <activity android:name=".StubActivity4" android:exported="false" />
        <activity android:name=".StubActivity5" android:exported="false" />
        <activity android:name=".StubActivity6" android:exported="false" />
        <activity android:name=".StubActivity7" android:exported="false" />
        <!-- singleTask / singleInstance 专用桩，launchMode 必须与 StubActivity.kt 的分组一致 -->
        <activity android:name=".StubTask0" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".StubTask1" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".StubTask2" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".StubTask3" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".StubInstance0" android:exported="false" android:launchMode="singleInstance" />
        <activity android:name=".StubInstance1" android:exported="false" android:launchMode="singleInstance" />
        <!-- 透明主题桩：给透明/悬浮的插件 Activity 用（窗口透明由 manifest 主题在 attach 时决定） -->
        <activity android:name=".StubTranslucent0" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".StubTranslucent1" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
